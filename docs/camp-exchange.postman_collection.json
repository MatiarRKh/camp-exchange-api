{
  "info": {
    "name": "Биржа обмена лагерями — API",
    "description": "Сквозной сценарий и проверки ошибок для демо-стенда. Запуск: Import → Run collection (папки по порядку) или `npx newman run camp-exchange.postman_collection.json`.\n\nПользователь передаётся заголовком X-User-Id (заглушка входа). Стенд сбрасывается в начале каждой папки и в конце второй.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://109.123.242.26:8000/api/v1"
    },
    {
      "key": "swapId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Обмен по цепочке из четырёх человек",
      "item": [
        {
          "name": "Сбросить стенд",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/demo/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo",
                "reset"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Каталог лагерей",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/camps",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "camps"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const camps = pm.response.json();",
                  "pm.test(\"63 лагеря сезона\", () => pm.expect(camps.length).to.eql(63));",
                  "pm.test(\"Из Кижей (id 8) хочет уйти Анна, попасть туда пока не хочет никто\", () => {",
                  "  const kizhi = camps.find(c => c.id === 8);",
                  "  pm.expect(kizhi.want_to_leave).to.eql(1);",
                  "  pm.expect(kizhi.want_to_join).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Григорий (p004) подаёт заявку в Кижи",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "p004"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "request"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wishes\": [\n    8,\n    17\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Заявка замыкает цепочку Кижи → Валдайский → Забайкальский → Пасвик: подбор запускается сразу."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Заявка сразу попала в обмен\", () => pm.expect(body.status).to.eql(\"in_swap\"));",
                  "pm.test(\"Желание №1 — Кижи\", () => pm.expect(body.wishes[0].camp.id).to.eql(8));",
                  "pm.collectionVariables.set(\"swapId\", body.active_swap_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Карточка обмена глазами Григория",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "p004"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/swaps/{{swapId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "swaps",
                "{{swapId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const swap = pm.response.json();",
                  "pm.test(\"Цепочка из четырёх, статус proposed\", () => {",
                  "  pm.expect(swap.members.length).to.eql(4);",
                  "  pm.expect(swap.status).to.eql(\"proposed\");",
                  "});",
                  "pm.test(\"Кто куда: каждый получает лагерь следующего\", () => {",
                  "  const moves = Object.fromEntries(swap.members.map(m => [m.participant_id, [m.from_camp.id, m.to_camp.id]]));",
                  "  pm.expect(moves).to.eql({p001: [8, 7], p002: [7, 3], p003: [3, 13], p004: [13, 8]});",
                  "});",
                  "pm.test(\"Контакты до подтверждения скрыты\", () => swap.members.forEach(m => pm.expect(m.contacts).to.be.null));",
                  "pm.test(\"Срок ответа — около 48 часов\", () => pm.expect(swap.seconds_left).to.be.within(47 * 3600, 48 * 3600));"
                ]
              }
            }
          ]
        },
        {
          "name": "Фонд не может согласовать, пока не согласны все",
