# systemd user service: ~/.config/systemd/user/camp-exchange-api.service
[Unit]
Description=Camp exchange API (demo)
After=network-online.target

[Service]
WorkingDirectory=%h/camp-exchange-api
ExecStart=%h/camp-exchange-api/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
